{
  "name": "jack-academy",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jack-academy/contracts build && pnpm --parallel --filter @jack-academy/api --filter @jack-academy/web dev",
    "dev:web": "pnpm --filter @jack-academy/contracts build && pnpm --filter @jack-academy/web dev",
    "dev:api": "pnpm --filter @jack-academy/contracts build && pnpm --filter @jack-academy/api dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @jack-academy/contracts build && pnpm -r test",
    "preview": "pnpm --filter @jack-academy/web preview",
    "db:migrate": "pnpm --filter @jack-academy/contracts build && pnpm --filter @jack-academy/api db:migrate"
  }
}
