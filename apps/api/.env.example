NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kubenautas:kubenautas@localhost:5432/kubenautas
# Generate a random value with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_URL=http://localhost:5173
# Browser-facing API URL: Vite forwards /api to NestJS during development.
API_PUBLIC_URL=http://localhost:5173/api
TRUST_PROXY=0
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Verified login emails allowed to access /admin, comma-separated. Empty denies access.
ADMIN_EMAILS=
